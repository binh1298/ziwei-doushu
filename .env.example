# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 本机 Claude Code 作为解读后端（本仓库自带的 /api/interpret 与 /api/heming）───
# 机器上装好并登录 Claude Code 后即可用，不需要任何 API Key。以下两项都可不填。
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe   # claude 不在 PATH 时指定
# CLAUDE_LOCAL_MODEL=sonnet                         # 传给 claude --model；不填用 Claude Code 自己的默认模型
